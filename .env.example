# Core Configuration
ENVIRONMENT="development"
LOG_LEVEL="INFO"

# Sovereign Data Paths (within the container)
INPUT_DATA_PATH="/app/data/dataset.csv"
MODEL_OUTPUT_PATH="/app/models/anomaly_model.joblib"

# Model Hyperparameters
MODEL_CONTAMINATION="0.1"
MODEL_TYPE="isolation_forest" # Example: isolation_forest, knn, autoencoder

# Data Provenance
MANIFEST_OUTPUT_PATH="/app/data/manifests/" # Directory where training saves manifests
DATA_MANIFEST_PATH="/app/data/manifests/default_data_manifest.json" # Specific manifest for `verify` to check against INPUT_DATA_PATH

# Encryption Settings
ENCRYPTION_ENABLED="False" # Set to "True" to enable
ENCRYPTION_KEY_DERIVATION_ITERATIONS="100000"
# SOVEREIGN_ENCRYPTION_KEY="" # For direct key (not recommended for production)
# ENCRYPTION_PASSWORD="" # For password-based key derivation (prompted if not set and needed)
# ENCRYPTION_SALT_HEX="" # Salt for password-based key, store this if you use a password

# Domain Configuration (for Phase 2 and beyond)
DOMAIN="default" # e.g., financial_fraud, network_intrusion, industrial_sensors
MODEL_STORE_PATH="/app/models/store/"
EXPERIMENT_LOG_DIR="/app/logs/experiments/"

# API Server (if configurable, though usually fixed in code)
# API_HOST="0.0.0.0"
# API_PORT="8000"
